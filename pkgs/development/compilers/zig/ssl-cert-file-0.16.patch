+/// Loads the root certificates from the file that SSL_CERT_FILE names, in
+/// place of the operating system's store, which a build sandbox can hide
+/// (https://codeberg.org/ziglang/zig/issues/36288). A file that cannot be
+/// opened leaves the operating system's store in use: Nix builds set
+/// SSL_CERT_FILE to a path that does not exist.
+fn loadCaBundleFromEnv(http_client: *std.http.Client, environ_map: *const process.Environ.Map) void {
+    const path = environ_map.get("SSL_CERT_FILE") orelse return;
+    const io = http_client.io;
+    var file = Io.Dir.cwd().openFile(io, path, .{}) catch return;
+    defer file.close(io);
+    var file_reader = file.reader(io, &.{});
+    const now = Io.Clock.real.now(io);
+    http_client.ca_bundle.addCertsFromFile(http_client.allocator, &file_reader, now.toSeconds()) catch |err|
+        fatal("unable to load certificates from SSL_CERT_FILE '{s}': {t}", .{ path, err });
+    http_client.now = now;
+}
